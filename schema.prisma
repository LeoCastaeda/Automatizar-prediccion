generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Alert {
  id              Int       @id @default(autoincrement())
  userId          Int
  symbol          String
  currency        String
  type            String    // AlertType: PRICE or CHANGE_PERCENT (renamed from CHANGE_% for valid TypeScript identifier)
  targetValue     Float?
  percentage      Float?
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  initialPrice    Float?
  user            User      @relation(fields: [userId], references: [id])

  @@index([symbol, currency, type])
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  alerts    Alert[]
}
