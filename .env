PORT=3000
API_KEY=test-api-key-123

# Local development uses SQLite so the project works without a running Postgres service.
# Render production should set DATABASE_URL to a real PostgreSQL connection string.
DATABASE_URL="file:../dev.db"

# SMTP (opcional - puedes dejarlo vacío si no quieres emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Telegram (opcional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
